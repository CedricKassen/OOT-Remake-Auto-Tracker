#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Simulator builds for Apple-silicon Macs only. Flutter 3.38 checks a
// two-architecture simulator build with a lipo call that Xcode 27 rejects
// (same break as in macos/Runner/Configs/Release.xcconfig).
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
